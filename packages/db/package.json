{
  "name": "@setupro/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests test/unit",
    "test:live": "vitest run test/live --reporter verbose",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "devDependencies": {
    "@setupro/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@setupro/core": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "https-proxy-agent": "^9.1.0",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  }
}
